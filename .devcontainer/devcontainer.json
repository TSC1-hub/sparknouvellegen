{
  "name": "sparknouvellegen",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Démo HTTP",
      "onAutoForward": "openBrowserOnce",
      "visibility": "public"
    }
  },
  "postStartCommand": "pkill -f 'http.server 8080' 2>/dev/null; cd /workspaces/sparknouvellegen && nohup python3 -m http.server 8080 > /tmp/http8080.log 2>&1 &"
}
